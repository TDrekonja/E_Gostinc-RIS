<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" prefWidth="800.0" prefHeight="480.0"
      stylesheets="@blagajna.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.egostinc.ZM_Skladisce">

    <HBox alignment="CENTER_LEFT" styleClass="skladisce-header" spacing="12">
        <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
        <Label text="PREGLED SKLADIŠČA" styleClass="label-naslov-racun" style="-fx-padding: 0;" />
    </HBox>

    <TableView fx:id="tabelaSestavin" VBox.vgrow="ALWAYS" style="-fx-padding: 10 16 0 16;">
        <columns>
            <TableColumn fx:id="stolpecSifra"  text="Šifra"          prefWidth="60.0"  minWidth="50.0"  maxWidth="70.0" />
            <TableColumn fx:id="stolpecNaziv"  text="Naziv sestavine" prefWidth="350.0" minWidth="200.0" />
            <TableColumn fx:id="stolpecZaloga" text="Zaloga"          prefWidth="100.0" minWidth="80.0"  maxWidth="120.0" />
            <TableColumn fx:id="stolpecMeja"   text="Min. meja"       prefWidth="100.0" minWidth="80.0"  maxWidth="120.0" />
            <TableColumn fx:id="stolpecStatus" text="Status"          prefWidth="120.0" minWidth="100.0" maxWidth="140.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <Label text="Ni sestavin v skladišču." />
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <padding><Insets top="10" right="20" bottom="16" left="20"/></padding>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="●" style="-fx-text-fill: #27ae60; -fx-font-size: 16px;"/>
            <Label text="Zadostna zaloga" styleClass="hint-tekst"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="●" style="-fx-text-fill: #e67e22; -fx-font-size: 16px;"/>
            <Label text="Nizka zaloga" styleClass="hint-tekst"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <Label text="●" style="-fx-text-fill: #c0392b; -fx-font-size: 16px;"/>
            <Label text="Premalo!" styleClass="hint-tekst"/>
        </HBox>
        <HBox HBox.hgrow="ALWAYS" />
        <Button text="Osveži" styleClass="gumb-refresh" onAction="#osvezi" />
    </HBox>

</VBox>
