<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" prefWidth="700.0" prefHeight="480.0"
      stylesheets="@blagajna.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.egostinc.ZM_DnevniPromet">

    <HBox alignment="CENTER_LEFT" styleClass="skladisce-header" spacing="12">
        <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
        <Label text="DNEVNI PROMET" styleClass="label-naslov-racun" style="-fx-padding: 0;" />
        <HBox HBox.hgrow="ALWAYS" />
        <Label fx:id="labelSkupajDan" text="Skupaj: 0,00 €"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c4a7c;" />
    </HBox>

    <TableView fx:id="tabelaRacunov" VBox.vgrow="ALWAYS" style="-fx-padding: 10 16 0 16;">
        <columns>
            <TableColumn fx:id="stolpecSt"      text="#"          minWidth="50.0"  prefWidth="55.0"  />
            <TableColumn fx:id="stolpecCas"     text="Čas"        minWidth="80.0"  prefWidth="90.0"  />
            <TableColumn fx:id="stolpecNatakar" text="Natakar"    minWidth="160.0" prefWidth="220.0" />
            <TableColumn fx:id="stolpecNacin"   text="Plačilo"    minWidth="120.0" prefWidth="140.0" />
            <TableColumn fx:id="stolpecZnesek"  text="Znesek"     minWidth="90.0"  prefWidth="100.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <Label text="Danes še ni zaključenih računov." />
        </placeholder>
    </TableView>

    <HBox spacing="30" alignment="CENTER_LEFT">
        <padding><Insets top="12" right="20" bottom="14" left="20"/></padding>
        <VBox spacing="2">
            <Label text="Gotovina" styleClass="hint-naslov"/>
            <Label fx:id="labelGotovina" text="0,00 €"
                   style="-fx-font-weight: bold; -fx-text-fill: #27ae60; -fx-font-size: 14px;" />
        </VBox>
        <VBox spacing="2">
            <Label text="Kartica" styleClass="hint-naslov"/>
            <Label fx:id="labelKartica" text="0,00 €"
                   style="-fx-font-weight: bold; -fx-text-fill: #2980b9; -fx-font-size: 14px;" />
        </VBox>
        <VBox spacing="2">
            <Label text="Število računov" styleClass="hint-naslov"/>
            <Label fx:id="labelStRacunov" text="0"
                   style="-fx-font-weight: bold; -fx-text-fill: #4a6fa5; -fx-font-size: 14px;" />
        </VBox>
        <HBox HBox.hgrow="ALWAYS" />
        <Button text="Osveži" styleClass="gumb-refresh" onAction="#osvezi" />
    </HBox>

</VBox>
